import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.io.IOException;
import java.util.StringTokenizer;

public class Main {

    public static int[][] arr, temp;

    public static void main(String[] args) throws IOException {
        // 입력
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringBuilder sb = new StringBuilder();
        StringTokenizer st;

        int n = Integer.parseInt(br.readLine());

        // 배열 생성 및 초기화
        arr = new int[n + 1][2];
        temp = new int[n + 1][2];

        for(int i = 1; i <= n; i++) {
            st = new StringTokenizer(br.readLine());
            int x = Integer.parseInt(st.nextToken());
            int y = Integer.parseInt(st.nextToken());
            arr[i][0] = x;
            arr[i][1] = y;
        }

        // 정렬 (분할정복)
        // 1. 배열을 가장 작은 크기로 나눈다
        divide(1, n);	

        // 출력
        for(int i = 1; i <= n; i++) {
            sb.append(arr[i][0]).append(" ").append(arr[i][1]).append("\n");
        }
        System.out.println(sb);
    }

    // 배열 분할
    public static void divide(int left, int right) {
        // 재귀 호출 종료
        if(left >= right) {
            return;
        }

        int mid = (left + right) /2;

        // 배열 분할
        divide(left, mid);
        divide(mid + 1, right);

        // 배열 병합
        merge(left, right);
    }

    // 배열 병합
    public static void merge(int left, int right) {
        // 원 배열의 값을 임시 배열에 복사
        for(int i = left; i <= right; i++) {
            temp[i][0] = arr[i][0];
            temp[i][1] = arr[i][1];
        }

        int mid = (left + right) / 2;

        int tempLeft = left;
        int tempRight = mid + 1;
        int curIndex = left;

        // temp[tempLeft ~ mid] / temp[mid + 1 ~ tempRight] 두 구간으로 나누어짐
        while(tempLeft <= mid && tempRight <= right) {
            // 정렬 조건 비교
            // x, y 오름차순
            if(temp[tempLeft][0] < temp[tempRight][0] || 
                    (temp[tempLeft][0] == temp[tempRight][0] && temp[tempLeft][1] < temp[tempRight][1])) {
                // 왼쪽 원소의 x가 더 작은 경우 또는 두 원소의 x가 같고 왼쪽 원소의 y가 더 작은 경우
                arr[curIndex][0] = temp[tempLeft][0];
                arr[curIndex][1] = temp[tempLeft][1];
                tempLeft++;

            } else { // 오른쪽 원소의 x가 더 작은 경우
                arr[curIndex][0] = temp[tempRight][0];
                arr[curIndex][1] = temp[tempRight][1];
                tempRight++;
            }
            curIndex++;
        }

        // 한 쪽 배열의 정렬이 다 끝나면 while 종료

        // 오른쪽, 왼쪽 각 구간은 이미 정렬된 상태이므로 잔여 배열은 순차적으로 원 배열 복사하면 됨
        // 오른쪽 배열에 원소가 남아있어도 추가로 복사할 필요 없음 이미 arr에 정렬된 상태로 있기 때문임

        // 왼쪽 배열이 남은 경우
        while(tempLeft <= mid) {
            arr[curIndex][0] = temp[tempLeft][0];
            arr[curIndex][1] = temp[tempLeft][1];
            curIndex++;
            tempLeft++;
        }
    }
}
